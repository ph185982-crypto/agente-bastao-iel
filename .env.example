# ── IA (texto) ────────────────────────────────────────────
# O backend tenta os provedores NESTA ORDEM e pula pro próximo quando um falha
# (chave inválida, cota estourada, modelo desativado, prompt grande demais).
# Basta UMA chave para o app funcionar — as outras são reforço.
# Todas abaixo têm plano gratuito, menos a OpenAI, que fica por último de propósito.

# 1) Groq — free tier, o mais rápido. https://console.groq.com/keys
GROQ_API_KEY=

# 2) Google Gemini — free tier generoso e contexto grande.
#    Pegue em https://aistudio.google.com/apikey (é diferente da GOOGLE_API_KEY abaixo)
GEMINI_API_KEY=

# 3) Cerebras — free tier. https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# 4) OpenRouter — usa só os modelos com sufixo :free. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 5) OpenAI — PAGA. Só é usada se todas as gratuitas acima falharem.
#    Deixe vazia para garantir que nada seja cobrado.
OPENAI_API_KEY=

# ── Serviços externos ─────────────────────────────────────
# socialkit.dev — download de vídeos do Instagram (Reels). Principal.
# https://socialkit.dev
SOCIALKIT_API_KEY=

# RapidAPI — reserva do download acima; e download de TikTok/YouTube (tem cota mensal paga)
RAPIDAPI_KEY=

# Shotstack — renderização de vídeo (PAGO por render)
SHOTSTACK_SANDBOX_KEY=
SHOTSTACK_PROD_KEY=

# Pexels — banco de imagens (gratuito)
PEXELS_API_KEY=

# Google Programmable Search — imagens nos carrosséis (exige billing no GCP).
# Opcional: sem elas o app só ignora essa fonte de imagem.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ── Servidor ──────────────────────────────────────────────
# Porta do backend (padrão: 3001)
PORT=3001

# URL do frontend (usada no CORS em produção)
FRONTEND_URL=https://your-app.vercel.app

# Handle e nome exibidos nos carrosséis
PROFILE_HANDLE=@seu_handle
PROFILE_NAME=Seu Nome

# ── Frontend ──────────────────────────────────────────────
# URL base do backend (deixe vazio para usar o proxy do Vite em dev local)
VITE_API_URL=

# ── Publicação no Instagram (Meta Graph API) — só NOMES; valores só na Vercel ──
# Veja docs/META_SETUP.md. Nunca coloque valores reais aqui nem no chat.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=
# Segredo que assina os links de imagem entregues à Meta (qualquer frase longa)
PUBLISH_SECRET=
# Endereço público do app (a Meta baixa as imagens por ele), ex.: https://seu-app.vercel.app
PUBLIC_BASE_URL=
# Segredo do cron diário (a própria Vercel o envia)
CRON_SECRET=
# Código de acesso do app (mínimo 10 caracteres)
APP_ACCESS_CODE=
# Cópia no servidor (Postgres/Neon)
DATABASE_URL=

# Notificações (Web Push, gratuito): gere o par com  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelo padrão (https://seu-app ou mailto:voce@exemplo.com)
VAPID_SUBJECT=
# Facebook (opcional, desligado por padrão): ver docs/META_SETUP.md

# Fundo por IA do visual "reportagem" (opcional, DESLIGADO por padrão; gasta crédito da OpenAI). Ver docs/IMAGENS_OPENAI.md
IMAGEM_OPENAI_LIGADA=
OPENAI_IMAGE_MODEL=gpt-image-1.5
IMAGEM_TETO_CARROSSEL_USD=2.00
IMAGEM_TETO_MES_USD=10.00
