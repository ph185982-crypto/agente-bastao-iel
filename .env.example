# ── IA (texto) ────────────────────────────────────────────
# O backend tenta os provedores NESTA ORDEM e pula pro próximo quando um falha
# (chave inválida, cota estourada, modelo desativado, prompt grande demais).
# Basta UMA chave para o app funcionar — as outras são reforço.
# Todas abaixo têm plano gratuito, menos a OpenAI, que fica por último de propósito.

# 1) Groq — free tier, o mais rápido. https://console.groq.com/keys
GROQ_API_KEY=

# 2) Google Gemini — free tier generoso e contexto grande.
#    Pegue em https://aistudio.google.com/apikey (é diferente da GOOGLE_API_KEY abaixo)
GEMINI_API_KEY=

# 3) Cerebras — free tier. https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# 4) OpenRouter — usa só os modelos com sufixo :free. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 5) OpenAI — PAGA. Só é usada se todas as gratuitas acima falharem.
#    Deixe vazia para garantir que nada seja cobrado.
OPENAI_API_KEY=

# ── Serviços externos ─────────────────────────────────────
# socialkit.dev — download de vídeos do Instagram (Reels). Principal.
# https://socialkit.dev
SOCIALKIT_API_KEY=

# RapidAPI — reserva do download acima; e download de TikTok/YouTube (tem cota mensal paga)
RAPIDAPI_KEY=

# Shotstack — renderização de vídeo (PAGO por render)
SHOTSTACK_SANDBOX_KEY=
SHOTSTACK_PROD_KEY=

# Pexels — banco de imagens (gratuito)
PEXELS_API_KEY=

# Google Programmable Search — imagens nos carrosséis (exige billing no GCP).
# Opcional: sem elas o app só ignora essa fonte de imagem.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ── Servidor ──────────────────────────────────────────────
# Porta do backend (padrão: 3001)
PORT=3001

# URL do frontend (usada no CORS em produção)
FRONTEND_URL=https://your-app.vercel.app

# Handle e nome exibidos nos carrosséis
PROFILE_HANDLE=@seu_handle
PROFILE_NAME=Seu Nome

# ── Frontend ──────────────────────────────────────────────
# URL base do backend (deixe vazio para usar o proxy do Vite em dev local)
VITE_API_URL=
