# ── Backend ──────────────────────────────────────────────
# API key from RapidAPI — used to download Instagram videos
RAPIDAPI_KEY=your_rapidapi_key_here

# API key from Anthropic — used for OCR and copy generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Port for the backend server (default: 3001)
PORT=3001

# URL of the frontend (used for CORS in production)
FRONTEND_URL=https://your-netlify-app.netlify.app

# ── Frontend (Netlify) ────────────────────────────────────
# URL of the Render backend (leave empty to use Vite proxy in local dev)
VITE_API_URL=https://nexos-paginas-backend.onrender.com
