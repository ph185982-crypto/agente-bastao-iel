{
  "version": 2,
  "installCommand": "npm install --production && cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{node_modules/ffprobe-static/bin/linux/x64/**,backend/assets/**}",
      "excludeFiles": "node_modules/ffprobe-static/bin/{darwin,win32}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/content-finder/mine", "schedule": "0 9 * * *" }
  ]
}
