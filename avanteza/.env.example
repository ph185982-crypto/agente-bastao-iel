# ── Supabase (schema "avanteza") ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mercado Livre ──
ML_CLIENT_ID=6409718634983655
ML_CLIENT_SECRET=           # segredo: cadastrar só na Vercel
ML_USE_PKCE=false           # "true" se o PKCE estiver ligado no app do DevCenter
# ML_REDIRECT_URI=          # opcional; padrão: $APP_URL/api/auth/mercadolivre/callback

# ── Segurança ──
ENCRYPTION_KEY=             # openssl rand -base64 32
CRON_SECRET=                # openssl rand -base64 32 (o mesmo valor vai no Vault do Supabase)
ADMIN_EMAILS=               # e-mails autorizados, separados por vírgula
APP_URL=https://app.avanteza.com.br

# ── Alertas por e-mail (Resend) ──
RESEND_API_KEY=
ALERT_EMAIL_FROM=           # ex.: Avanteza <alertas@avanteza.com.br>
ALERT_EMAIL_TO=

# ── Fase 2 (IA) ──
ANTHROPIC_API_KEY=
