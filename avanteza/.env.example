# ── Banco (Neon, criado pela integração da Vercel) ──
DATABASE_URL=
SESSION_SECRET=             # openssl rand -base64 48

# ── Mercado Livre ──
ML_CLIENT_ID=6409718634983655
ML_CLIENT_SECRET=           # segredo: cadastrar só na Vercel
ML_USE_PKCE=false           # "true" se o PKCE estiver ligado no app do DevCenter
# ML_REDIRECT_URI=          # opcional; padrão: $APP_URL/api/auth/mercadolivre/callback

# ── Segurança ──
ENCRYPTION_KEY=             # openssl rand -base64 32
CRON_SECRET=                # openssl rand -base64 32 (o mesmo valor vai no Vault do Supabase)
ADMIN_EMAILS=admin@avanteza.com.br   # e-mails autorizados, separados por vírgula
APP_URL=https://app.avanteza.com.br

# ── Alertas por e-mail (Resend) ──
RESEND_API_KEY=
ALERT_EMAIL_FROM=           # ex.: Avanteza <alertas@avanteza.com.br>
ALERT_EMAIL_TO=

# ── Fase 2 (IA) ──
ANTHROPIC_API_KEY=          # segredo: cadastrar só na Vercel
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium            # low | medium | high

# ── Fase 3 (Shopee) ──
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=         # segredo: cadastrar só na Vercel
# SHOPEE_API_HOST=https://partner.shopeemobile.com

# ── TikTok Shop (Partner Center) ──
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=          # segredo: cadastrar só na Vercel
TIKTOK_SERVICE_ID=          # ID do serviço (link de autorização do vendedor)

# ── Dashboards (aba inicial da equipe) ──
# Marketing: Meta Marketing API (Graph v21.0), SOMENTE LEITURA (permissão ads_read). Segredo: cadastrar só na Vercel.
META_ACCESS_TOKEN=
# Financeiro/comercial: Vendedor IA (endpoint de agregados). A chave é a MESMA do projeto nexo-vendedoria. Segredo: só na Vercel.
AVANTEZA_METRICS_KEY=
VENDEDORIA_URL=             # opcional; padrão https://nexo-vendedoria.vercel.app
# Só desenvolvimento (ignorado com NODE_ENV=production): 1 = dados simulados, vazio = fontes sem dados, erro = fontes fora do ar
# DASHBOARDS_FIXTURE=1

# ── Canais dos clientes (Mapa → Canais; Meta Graph v21.0, SOMENTE LEITURA) ──
# O token de cada cliente é colado na aba Canais da Central e guardado criptografado (ENCRYPTION_KEY). Nada a configurar aqui por cliente.
# Opcional: o canal pode usar o META_ACCESS_TOKEN da plataforma (acima) quando o cliente não tem token próprio.
# A rotina /api/cron/channels (1×/dia) usa o CRON_SECRET já existente.
# Só desenvolvimento (ignorado com NODE_ENV=production/VERCEL_ENV=production): 1 = dados simulados do cliente de demonstração
# CHANNELS_FIXTURE=1

# ── Instagram dos clientes pelo Windsor.ai (fonte 2, independente da Meta Ads; SOMENTE LEITURA) ──
# Chave de API do Windsor.ai da plataforma. Segredo: cadastrar só na Vercel. Cada canal pode ter chave própria (cifrada) na aba Canais.
WINDSOR_API_KEY=

# ── Financeiro (Vendedor IA) ──
# AVANTEZA_FINANCE_KEY=      # a MESMA do projeto nexo-vendedoria (openssl rand -base64 36). Sem ela o Financeiro mostra "não configurado".
# VENDEDORIA_URL=            # já usada nos Dashboards (padrão https://nexo-vendedoria.vercel.app)
# SSO_APPS=vendas,crm,contratos,conteudo   # apps com login único (atalhos do Comercial/Marketing)
# FINANCEIRO_FIXTURE=1       # SÓ desenvolvimento: dados simulados (ignorada com NODE_ENV/VERCEL_ENV=production)
# Abas do Financeiro (Etapa 2): Projeção, Contratos de despesa e Histórico (Empresa e Pessoal); Orçamentos e Dívidas só no Pessoal. Exigem o Vendedor IA com a API de serviço da etapa 2.
# Motor de Entregas — Inbox de combinados (POST /api/capturas). Gere com: openssl rand -base64 36. Sem ela a rota responde 503.
# AVANTEZA_CAPTURE_KEY=
